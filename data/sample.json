  "sentences": [
    {
      "id": "xueyi-1",
      "work_id": "xueyi",
      "position": 1,
      "text": "弈秋，通国之善弈者也。",
      "source_text": "弈秋，通國之善弈者也。",
      "explanation": "弈秋是全国擅长下棋的人。",
      "status": "pending"
    },
    {
      "id": "xueyi-2",
      "work_id": "xueyi",
      "position": 2,
      "text": "使弈秋诲二人弈：其一人专心致志，惟弈秋之为听；一人虽听之，一心以为有鸿鹄将至，思援弓缴而射之。",
      "source_text": "使弈秋誨二人弈：其一人專心致志，惟弈秋之為聽；一人雖聽之，一心以為有鴻鵠將至，思援弓繳而射之。",
      "explanation": "两人同学下棋，一人专心，一人想着射鸟。原典用“惟”，不替换为未经核对的教材字形。",
      "status": "pending"
    },
    {
      "id": "xueyi-3",
      "work_id": "xueyi",
      "position": 3,
      "text": "虽与之俱学，弗若之矣。",
      "source_text": "雖與之俱學，弗若之矣。",
      "explanation": "虽然一起学习，结果却不如那位专心的人。",
      "status": "pending"
    },
    {
      "id": "xueyi-4",
      "work_id": "xueyi",
      "position": 4,
      "text": "为是其智弗若与？曰：非然也。",
      "source_text": "為是其智弗若與？曰：非然也。",
      "explanation": "这是因为他的智力不如对方吗？回答：不是这样。",
      "status": "pending"
    },
    {
      "id": "loushi-1",
      "work_id": "loushi",
      "position": 1,
      "text": "山不在高，有仙则名。水不在深，有龙则灵。",
      "source_text": "山不在高，有仙則名。水不在深，有龍則靈。",
      "explanation": "开篇用山水作比。",
      "status": "pending"
    },
    {
      "id": "loushi-2",
      "work_id": "loushi",
      "position": 2,
      "text": "斯是陋室，惟吾德馨。",
      "source_text": "斯是陋室，惟吾德馨。",
      "explanation": "居所虽简陋，重在居住者的品德。",
      "status": "pending"
    },
    {
      "id": "loushi-3",
      "work_id": "loushi",
      "position": 3,
      "text": "无丝竹之乱耳，无案牍之劳形。",
      "source_text": "無絲竹之亂耳，無案牘之勞形。",
      "explanation": "以两组主谓结构写没有喧闹声和公文带来的烦扰。",
      "status": "pending"
    },
    {
      "id": "loushi-4",
      "work_id": "loushi",
      "position": 4,
      "text": "孔子云：何陋之有？",
      "source_text": "孔子云：何陋之有？",
      "explanation": "“何陋”移到“有”前面；具体语法标签留待教师复核。",
      "status": "pending"
    },
    {
      "id": "ailian-1",
      "work_id": "ailian",
      "position": 1,
      "text": "水陆草木之花，可爱者甚蕃。",
      "source_text": "水陸草木之花，可愛者甚蕃。",
      "explanation": "水上陆地上的花，值得喜爱的很多。",
      "status": "pending"
    },
    {
      "id": "ailian-2",
      "work_id": "ailian",
      "position": 2,
      "text": "予独爱莲之出淤泥而不染，濯清涟而不妖。",
      "source_text": "予獨愛蓮之出淤泥而不染，濯清漣而不妖。",
      "explanation": "写莲的生长环境和姿态，用来表达作者的欣赏。",
      "status": "pending"
    },
    {
      "id": "ailian-3",
      "work_id": "ailian",
      "position": 3,
      "text": "予谓菊，花之隐逸者也；牡丹，花之富贵者也；莲，花之君子者也。",
      "source_text": "予謂菊，花之隱逸者也；牡丹，花之富貴者也；蓮，花之君子者也。",
      "explanation": "用不同的人格类型比喻三种花。",
      "status": "pending"
    }
  ],
